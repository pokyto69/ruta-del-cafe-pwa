{
  "name": "ruta-del-cafe-pwa",
  "version": "1.0.0",
  "description": "Ruta del Café: Aplicación Web Progresiva con app shell, service worker, offline, Background Sync y notificaciones push.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "iconos": "node scripts/generar-iconos.js",
    "vapid": "node scripts/generar-vapid.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js tests/pwa.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:e2e": "node --test tests/pwa.test.js"
  },
  "keywords": [
    "pwa",
    "service-worker",
    "offline",
    "push"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.3.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0"
  }
}
